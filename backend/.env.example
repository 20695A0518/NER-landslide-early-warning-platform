# ============================================================
#  PRAHARI - Environment configuration
#  Copy to `.env` and adjust. Every integration falls back to a
#  deterministic simulator when its key is absent, so the whole
#  platform runs end-to-end with this file untouched.
# ============================================================

APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-64-char-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite by default; swap for PostgreSQL/PostGIS in production:
# DATABASE_URL=postgresql+psycopg://prahari:prahari@localhost:5432/prahari
DATABASE_URL=sqlite:///./prahari.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Weather providers -------------------------------------
# India Meteorological Department (Mausam) API
IMD_API_BASE=https://mausam.imd.gov.in/api
IMD_API_KEY=
# OpenWeatherMap fallback (free tier works)
OPENWEATHER_API_KEY=
# When both are blank the physically-grounded monsoon simulator is used.
WEATHER_POLL_MINUTES=30

# --- Satellite feeds ---------------------------------------
# Bhuvan (ISRO) / Sentinel Hub. Blank => cached NDVI + terrain rasters.
BHUVAN_API_KEY=
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# --- SMS / alerting ----------------------------------------
# Provider: console | twilio | msg91
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PRAHRI

# --- Risk engine tuning ------------------------------------
RISK_CYCLE_MINUTES=15
ALERT_THRESHOLD_HIGH=0.65
ALERT_THRESHOLD_CRITICAL=0.82

# Generate sensor telemetry when no physical network is installed.
SIMULATE_SENSORS=true
